<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Must match the app's group exactly, or the extension cannot read the
         encryption key and every notification arrives unreadable. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.gruncode.dialbridge</string>
    </array>
</dict>
</plist>
